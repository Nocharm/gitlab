# 실제 배포 값은 여기 두지 말고 .env 에만 작성한다 (.env 는 .gitignore — 커밋 금지).
# 아래는 형식 안내용 placeholder.

# === GitLab ===
GITLAB_HOSTNAME=gitlab.example.local   # 실제 GitLab 호스트명으로 교체
GITLAB_HTTP_PORT=8080                  # GitLab 웹 포트 (host → 컨테이너 nginx 80). clone은 http

# === Keycloak OIDC SSO (선택) ===
# 미설정이어도 GitLab은 정상 기동하고 패스워드 로그인은 유지된다(병행). 채우면 "Keycloak" 버튼 활성.
# Keycloak client의 Valid Redirect URI:
#   http://<GITLAB_HOSTNAME>:<GITLAB_HTTP_PORT>/users/auth/openid_connect/callback
KEYCLOAK_ISSUER=https://keycloak.example.local/realms/main   # realm issuer URL(.well-known/openid-configuration 호스트)
KEYCLOAK_CLIENT_ID=gitlab               # Keycloak에 등록한 client id
# client secret (커밋 금지) — 빈 값 줄은 인라인 주석 금지(compose가 주석을 값으로 흡수함)
KEYCLOAK_CLIENT_SECRET=

# === Runner ===
CI_SERVER_URL=http://gitlab.example.local:8080
RUNNER_TOKEN=                          # UI/콘솔에서 발급 (커밋 금지)
RUNNER_TAGS=shell-71                   # job tags 와 일치해야 함
DOCKER_GID=999                         # `getent group docker`로 실측해 교체

# === 배포 앱 포트 범위 ===
DEPLOY_PORT_MIN=9000
DEPLOY_PORT_MAX=9099
